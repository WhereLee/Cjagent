    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5030220261016001",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.2"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.14",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5030220261016001",
    "@dcloudio/uni-stacktracey": "3.0.0-alpha-5030220261016001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5030220261016001",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.4.2",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "5.2.8",
    "vue-tsc": "^2.2.0"
