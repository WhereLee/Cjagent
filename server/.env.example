# 复制为 .env 后填真实值；.env 已在 .gitignore 内，绝不入库
# 格式为 properties（Spring Boot 通过 spring.config.import=optional:file:.env[.properties] 读取）

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=cabinet_dev
MYSQL_USERNAME=
MYSQL_PASSWORD=

PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=cabinet_agent
PG_USERNAME=
PG_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=8
REDIS_PASSWORD=

ROCKETMQ_NAME_SERVER=127.0.0.1:9876

# JWT 签名密钥（HS256 要求至少 32 字节；短了应用启动即失败）
# 自己生成一份，别用示例值，也别把真实值提交到任何地方：
#   openssl rand -base64 48
JWT_SECRET=

# 微信小程序；本地开发可以把 cabinet.mini.mock-login=true 打开绕过它
WECHAT_APP_ID=
WECHAT_APP_SECRET=
